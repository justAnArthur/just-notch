{
  "name": "just-notch",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "plugins/*"],
  "scripts": {
    "check": "bun run --filter '*' check",
    "build": "bun run --filter '@just-notch/runtime' build && bun run --filter './plugins/*' build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}

{
  "name": "just-notch",
  "version": "1.2.3",
  "description": "A modular Dynamic Island for the MacBook notch: a native Swift host, a React + modo-ui island, plugins for everything else.",
  "license": "FSL-1.1-MIT",
  "homepage": "https://justanarthur.github.io/just-notch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justAnArthur/just-notch.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "library/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "build": "bun run --filter '@just-notch/runtime' build && bun run --filter './plugins/*' build",
    "build:library": "bun run --filter './library/*' build",
    "notch": "bun packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "properties": {
    "gitCommitScopeRelatedNames": "just-notch,app,macos,host,services,runtime,island,sdk,cli,bridge-schema,plugins,now-playing,calendar,weather,clock,system,clipboard,recent-files"
  }
}
